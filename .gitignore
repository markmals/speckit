# OS / editor
.DS_Store
*.swp
*.swo
*.tmp
.vscode/
.idea/

# Environment (real values live in local .env files)
.env
.env.local
*.log

# Go build output
/specify
/dist/

# SpecKit state. specs.json (the target config) and lock/ (the D7 acknowledgment
# lock) are committed truth — drift detection is vacuous if a fresh clone has no
# lock. Everything else under .speckit/ is a local run artifact.
.speckit/*
!.speckit/specs.json
!.speckit/lock/

# Legacy local Python virtualenv
.venv/

# mise local overrides
mise.local.toml
.mise.local.toml

# Transient Codex run artifacts (per the dynamic-workflow policy)
.claude/codex-results/
.claude/schemas/

# Agent git worktrees live here; never track them (committing the worktree
# dir embeds a gitlink with no .gitmodules and breaks CI checkout cleanup)
.claude/worktrees/

# Local build/verify scratch
.cache/
