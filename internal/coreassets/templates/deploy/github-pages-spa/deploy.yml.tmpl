# Deploy [[.Name]] to GitHub Pages (SPA) on push to the default branch.
#
# No secrets — uses the built-in GITHUB_TOKEN. Enable Pages first:
# Settings → Pages → Source: "GitHub Actions". Mind the project base path
# (/<repo>/) in your build config, and the SPA 404 fallback below.
name: deploy
on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: jdx/mise-action@v4
      - run: pnpm install --frozen-lockfile
        working-directory: [[.Dir]]
      - run: pnpm run build
        working-directory: [[.Dir]]
      # SPA fallback: serve index.html for unknown client routes.
      - run: cp dist/index.html dist/404.html
        working-directory: [[.Dir]]
      - uses: actions/upload-pages-artifact@v3
        with:
          path: [[.Dir]]/dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
