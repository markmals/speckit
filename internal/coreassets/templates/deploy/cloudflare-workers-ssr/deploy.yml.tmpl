# Deploy [[.Name]] to Cloudflare Workers (SSR) on push to the default branch.
#
# Set CLOUDFLARE_API_TOKEN with `specify secrets sync` (resolved from 1Password).
# CLOUDFLARE_ACCOUNT_ID lives in [[.Dir]]/wrangler.jsonc — an identifier, not a
# secret — alongside the server entry. Independent of the PR gate (that runs on PRs).
name: deploy
on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: deploy-[[.Name]]
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: jdx/mise-action@v4
      - run: pnpm install --frozen-lockfile
        working-directory: [[.Dir]]
      - run: pnpm run build
        working-directory: [[.Dir]]
      - uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          workingDirectory: [[.Dir]]
          command: deploy
