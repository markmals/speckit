# Deploy [[.Name]] to Cloudflare Workers (static assets / SPA) on push.
#
# Assets-only: [[.Dir]]/wrangler.jsonc must set
#   assets.not_found_handling = "single-page-application"
# and carry no server worker. CLOUDFLARE_ACCOUNT_ID lives in wrangler.jsonc (an
# identifier, not a secret). Set CLOUDFLARE_API_TOKEN with `specify secrets sync`.
name: deploy
on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: deploy-[[.Name]]
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: jdx/mise-action@v4
      - run: pnpm install --frozen-lockfile
        working-directory: [[.Dir]]
      - run: pnpm run build
        working-directory: [[.Dir]]
      - uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          workingDirectory: [[.Dir]]
          command: deploy
