import TestSupport
import Testing

@testable import {{pascal .Name}}

// SPEC: story.version.compare
//
// The suite binds to its story via `.spec`; each test binds to its Gherkin scenario
// via `.scenario`. Function names are descriptive raw identifiers — Swift Testing
// reports them as the display name, the identity the engine joins against the
// event-stream report. The scenario ID lives in the trait (source), never the name.
@Suite(.spec("story.version.compare"))
struct VersionCompareTests {
    @Test(.scenario("scenario.version.compare.parse"))
    func `a dotted string parses into its three components`() {
        #expect(SemanticVersion(parsing: "1.2.3") == SemanticVersion(major: 1, minor: 2, patch: 3))
    }

    @Test(.scenario("scenario.version.compare.order"))
    func `ordering is numeric, not lexical`() {
        let older = SemanticVersion(major: 1, minor: 2, patch: 0)
        let newer = SemanticVersion(major: 1, minor: 10, patch: 0)
        #expect(older < newer)
    }
}
