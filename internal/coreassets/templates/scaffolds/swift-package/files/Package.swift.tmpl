// swift-tools-version: 6.0
import PackageDescription

// {{.Name}} — a reusable Swift package. Pure, headless library code that builds and
// tests with `swift test` alone, which is exactly what `specify verify` runs: no
// Xcode project, simulator, or signing. The module is named after the package
// ({{pascal .Name}}) over a static source directory (Sources/Library) via an explicit
// `path:` — the scaffold renderer substitutes file contents, not directory names, so
// the directory stays fixed while the module is named after the package.
let package = Package(
    name: "{{pascal .Name}}",
    platforms: [.macOS(.v13), .iOS(.v16)],
    products: [
        .library(name: "{{pascal .Name}}", targets: ["{{pascal .Name}}"])
    ],
    targets: [
        .target(name: "{{pascal .Name}}", path: "Sources/Library"),
        // Shared test support: the .spec/.scenario binding traits, in their own
        // target so every test target can import them.
        .target(name: "TestSupport", path: "Tests/Support"),
        .testTarget(
            name: "{{pascal .Name}}Tests",
            dependencies: ["{{pascal .Name}}", "TestSupport"],
            path: "Tests/LibraryTests"
        ),
    ]
)
