{
  "stack": "go-service",
  "memberDir": "cmd",
  "sharedModule": true,
  "scripts": [
    {
      "phase": 0,
      "commands": [
        "mise trust",
        "go mod tidy"
      ]
    }
  ],
  "target": {
    "command": "cd {{.Dir}} && mise run test",
    "format": "gotest",
    "report": "{{.Dir}}/test.gotest.json",
    "source": "{{.Dir}}",
    "bindings": "scoped"
  }
}
