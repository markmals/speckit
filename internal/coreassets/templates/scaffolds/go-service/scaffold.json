{
  "stack": "go-service",
  "memberDir": "cmd",
  "sharedModule": true,
  "scripts": [
    {
      "phase": 0,
      "commands": [
        "mise trust"
      ]
    },
    {
      "phase": 5,
      "commands": [
        "go mod tidy"
      ]
    }
  ],
  "features": {
    "openapi": {
      "files": "features/openapi/files",
      "scripts": [
        {
          "phase": 1,
          "commands": [
            "go get github.com/oapi-codegen/runtime",
            "go get -tool github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen"
          ]
        },
        {
          "phase": 2,
          "commands": [
            "mkdir -p internal/api && go tool oapi-codegen -config oapi-codegen.yaml openapi.yaml"
          ]
        }
      ]
    },
    "sqlite": {
      "files": "features/sqlite/files",
      "scripts": [
        {
          "phase": 1,
          "commands": [
            "go get github.com/glebarez/go-sqlite"
          ]
        }
      ]
    },
    "client": {
      "files": "features/client/files"
    }
  },
  "target": {
    "command": "cd {{.Dir}} && mise run test",
    "format": "gotest",
    "report": "{{.Dir}}/test.gotest.json",
    "source": "{{.Dir}}",
    "bindings": "scoped"
  }
}
