package main

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"testing"

	"{{.Module}}/{{.Dir}}/internal/api"
)

// [scenario.greeting.greet.hello]
func TestGreetEndpoint(t *testing.T) {
	mux := http.NewServeMux()
	api.HandlerFromMux(api.NewStrictHandler(&server{}, nil), mux)

	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/greeting/Ada", nil)
	mux.ServeHTTP(rec, req)

	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
	}
	var got api.Greeting
	if err := json.NewDecoder(rec.Body).Decode(&got); err != nil {
		t.Fatal(err)
	}
	if got.Message != "Hello, Ada!" {
		t.Errorf("message = %q, want %q", got.Message, "Hello, Ada!")
	}
}

// [scenario.greeting.greet.defaults-to-world]
func TestGreetDefaultsToWorld(t *testing.T) {
	if got := greeting(""); got != "Hello, world!" {
		t.Errorf("greeting(%q) = %q, want %q", "", got, "Hello, world!")
	}
}
