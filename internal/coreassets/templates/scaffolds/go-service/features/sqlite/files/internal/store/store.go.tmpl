// Package store is the service's SQLite persistence layer — a thin wrapper over
// database/sql using the pure-Go glebarez driver (no cgo, so the binary stays
// static). It ships with a settings KV table (see migrations/) as a worked
// example; replace it with your own schema + query methods.
//
// Wire it into your service's main:
//
//	db, err := store.Open(store.DSN())
//	if err != nil { /* ... */ }
//	defer db.Close()
//	if err := db.Migrate(ctx); err != nil { /* ... */ }
//	// then pass db into your handlers (e.g. &server{store: db})
package store

import (
	"context"
	"database/sql"
	"errors"
	"os"
	"path/filepath"

	_ "github.com/glebarez/go-sqlite"
)

// Store wraps the database handle. Every query takes a context for cancellation.
type Store struct{ db *sql.DB }

// DSN resolves the SQLite path from DATABASE_URL, defaulting to a local file
// under ./.data. Override it in production (a writable, persistent path).
func DSN() string {
	if v := os.Getenv("DATABASE_URL"); v != "" {
		return v
	}
	return "./.data/app.db"
}

// Open opens the SQLite database (creating its parent directory). A single open
// connection serializes writes — SQLite's sweet spot for a daemon — and the busy
// timeout absorbs brief lock contention.
func Open(dsn string) (*Store, error) {
	if dir := filepath.Dir(dsn); dir != "" && dir != "." {
		if err := os.MkdirAll(dir, 0o755); err != nil {
			return nil, err
		}
	}
	db, err := sql.Open("sqlite", dsn+"?_pragma=busy_timeout(5000)")
	if err != nil {
		return nil, err
	}
	db.SetMaxOpenConns(1)
	if err := db.Ping(); err != nil {
		return nil, err
	}
	return &Store{db: db}, nil
}

// Close closes the underlying database.
func (s *Store) Close() error { return s.db.Close() }

// Setting returns the value for a key, or ("", false) when absent. The settings
// table is a simple KV store — a common daemon configuration pattern.
func (s *Store) Setting(ctx context.Context, key string) (string, bool, error) {
	var v string
	err := s.db.QueryRowContext(ctx, "SELECT value FROM settings WHERE key = ?", key).Scan(&v)
	if errors.Is(err, sql.ErrNoRows) {
		return "", false, nil
	}
	if err != nil {
		return "", false, err
	}
	return v, true, nil
}

// SetSetting upserts a key/value into the settings table.
func (s *Store) SetSetting(ctx context.Context, key, value string) error {
	_, err := s.db.ExecContext(ctx,
		"INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value",
		key, value)
	return err
}
