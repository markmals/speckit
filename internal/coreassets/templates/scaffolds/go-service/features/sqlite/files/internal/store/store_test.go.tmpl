package store

import (
	"context"
	"path/filepath"
	"testing"
)

// An untagged unit test: under the go-service target's `bindings: scoped` mode it
// stays out of scenario scope (no `// [scenario.<id>]`), but it still runs and
// must pass — proving migrate + the settings KV roundtrip.
func TestStoreSettingsRoundTrip(t *testing.T) {
	db, err := Open(filepath.Join(t.TempDir(), "test.db"))
	if err != nil {
		t.Fatal(err)
	}
	defer db.Close()
	ctx := context.Background()

	if err := db.Migrate(ctx); err != nil {
		t.Fatal(err)
	}
	// Migrate is idempotent — a second run is a no-op.
	if err := db.Migrate(ctx); err != nil {
		t.Fatalf("second Migrate not idempotent: %v", err)
	}

	if _, ok, _ := db.Setting(ctx, "theme"); ok {
		t.Fatal("expected no value before set")
	}
	if err := db.SetSetting(ctx, "theme", "dark"); err != nil {
		t.Fatal(err)
	}
	got, ok, err := db.Setting(ctx, "theme")
	if err != nil || !ok || got != "dark" {
		t.Fatalf("Setting = (%q, %v, %v), want (dark, true, nil)", got, ok, err)
	}
}
