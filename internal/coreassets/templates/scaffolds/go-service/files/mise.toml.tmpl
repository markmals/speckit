# go-service: a Go HTTP daemon. Mise inherits the toolchain from the repo-root
# mise.toml and exposes the same task names the engine + CI expect; `test` writes
# the `go test -json` report the engine's gotest format joins.

[tasks.dev]
description = "run the service"
run = "go run ."

[tasks.build]
description = "build the service"
run = "go build ./..."

[tasks.test]
description = "run the Go suite, writing the JSON report the engine joins"
run = "go test -json ./... > test.gotest.json"

[tasks.vet]
description = "go vet"
run = "go vet ./..."

[tasks.fmt]
description = "format in place (gofmt)"
run = "gofmt -w ."

[tasks."fmt:check"]
description = "fail if any file needs formatting"
run = 'test -z "$(gofmt -l .)"'
{{if .Features.openapi}}
# The OpenAPI contract (openapi.yaml) is the source of truth; oapi-codegen emits
# the server interface into internal/api/api.gen.go (committed). Re-run after
# editing the contract.
[tasks.generate]
description = "regenerate the Go server from the OpenAPI contract (oapi-codegen)"
run = "mkdir -p internal/api && go tool oapi-codegen -config oapi-codegen.yaml openapi.yaml"
{{end}}
