# CI for the {{.Name}} target — dropped in by `specify target add`.
#
# Two required PR checks (see docs: branch-protection recipe):
#   quality  — the target's fast static checks (fmt:check / lint / typecheck)
#   verify   — the SpecKit spec gate: scan, the test-edit firewall, `verify`
#              (which runs the test suite and joins each scenario to its test),
#              and parity. Tests run only here, never in `quality`.
name: ci

on:
  pull_request:

concurrency:
  group: ci-{{ "${{" }} github.ref {{ "}}" }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  quality:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: {{.Dir}}
    steps:
      - uses: actions/checkout@v6
      - uses: jdx/mise-action@v4
      - run: mise install
      - run: pnpm install --frozen-lockfile
      - run: mise run fmt:check
      - run: mise run lint
      - run: mise run typecheck

  verify:
    uses: markmals/speckit/.github/workflows/gate.yml@v1
    with:
      target: {{.Name}}
      working_directory: {{.Dir}}
