{
  "stack": "web",
  "scripts": [
    {
      "phase": 0,
      "commands": [
        "mise trust",
        "pnpm add react react-dom @tanstack/react-router @tanstack/react-start @tanstack/react-query @tanstack/react-router-ssr-query @tanstack/virtual-file-routes motion tw-animate-css zod",
        "pnpm add -D vite @vitejs/plugin-react @rolldown/plugin-babel babel-plugin-react-compiler @tailwindcss/vite tailwindcss vitest vite-plugin-devtools-json @tanstack/router-cli @typescript/native-preview@latest oxlint oxfmt oxlint-tsgolint eslint-plugin-perfectionist eslint-plugin-prefer-let @types/node @types/react @types/react-dom",
        "pnpm install",
        "pnpm dlx shadcn@latest add @racket-ui/base @racket-ui/button --yes"
      ]
    },
    {
      "phase": 1,
      "commands": [
        "pnpm exec tsr generate"
      ]
    }
  ],
  "features": {
    "clerk": {
      "files": "features/clerk/files",
      "add": ["@clerk/tanstack-react-start"]
    },
    "tiptap": {
      "files": "features/tiptap/files",
      "add": ["@tiptap/react", "@tiptap/starter-kit", "@tiptap/pm"]
    },
    "posthog": {
      "add": ["posthog-js"]
    },
    "email": {
      "files": "features/email/files",
      "add": ["resend", "react-email", "@react-email/render"]
    },
    "stripe": {
      "files": "features/stripe/files",
      "add": ["stripe", "@stripe/stripe-js"]
    }
  },
  "dataDefault": "convex",
  "data": {
    "convex": {
      "files": "data/convex/files",
      "add": ["convex", "@convex-dev/react-query"],
      "scripts": [
        {
          "phase": 3,
          "commands": [
            "CONVEX_AGENT_MODE=anonymous pnpm exec convex dev --once",
            "grep -q '^VITE_CONVEX_URL=' .env.local || echo \"VITE_CONVEX_URL=$(grep '^CONVEX_URL=' .env.local | cut -d= -f2)\" >> .env.local"
          ]
        }
      ]
    },
    "drizzle": {
      "files": "data/drizzle/files",
      "runtimeFiles": {
        "cloudflare": "data/drizzle/cloudflare",
        "node": "data/drizzle/node"
      },
      "add": ["drizzle-orm@rc"],
      "addDev": ["drizzle-kit@rc"],
      "scripts": [
        {
          "phase": 3,
          "commands": ["pnpm exec drizzle-kit generate"]
        }
      ]
    },
    "none": {}
  },
  "runtimeDefault": "cloudflare",
  "runtime": {
    "cloudflare": {
      "files": "runtime/cloudflare/files",
      "addDev": ["@cloudflare/vite-plugin", "wrangler"],
      "scripts": [
        {
          "phase": 3,
          "commands": ["pnpm exec wrangler types"]
        }
      ]
    },
    "node": {
      "files": "runtime/node/files"
    }
  },
  "target": {
    "command": "cd {{.Dir}} && mise run test",
    "format": "junit",
    "report": "{{.Dir}}/junit.xml",
    "source": "{{.Dir}}/app"
  }
}
