{
  "stack": "web",
  "scripts": [
    {
      "phase": 0,
      "commands": [
        "pnpm add react react-dom @tanstack/react-router @tanstack/react-start",
        "pnpm add -D vite vitest typescript @vitejs/plugin-react @tailwindcss/vite tailwindcss @types/react @types/react-dom",
        "pnpm install"
      ]
    }
  ],
  "target": {
    "command": "cd {{.Dir}} && mise run test",
    "format": "junit",
    "report": "{{.Dir}}/junit.xml",
    "source": "{{.Dir}}/app"
  }
}
