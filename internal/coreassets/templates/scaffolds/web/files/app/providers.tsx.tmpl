{{if .Features.posthog}}import { PostHogProvider } from "posthog-js/react";

{{end}}/**
 * Client-side context providers, composed into the router's `Wrap`. Each
 * optional `--with` provider feature nests itself here, so they stack in a
 * single, deterministic place instead of fighting over root.tsx / router.tsx.
 */
export function Providers({ children }: { children: React.ReactNode }) {
    let tree = children;
{{if .Features.posthog}}
    let posthogKey = (import.meta.env.VITE_PUBLIC_POSTHOG_KEY as string | undefined) ?? "";
    let posthogOptions = {
        api_host:
            (import.meta.env.VITE_PUBLIC_POSTHOG_HOST as string | undefined) ??
            "https://us.i.posthog.com",
    };
    tree = (
        <PostHogProvider apiKey={posthogKey} options={posthogOptions}>
            {tree}
        </PostHogProvider>
    );
{{end}}
    return <>{tree}</>;
}
