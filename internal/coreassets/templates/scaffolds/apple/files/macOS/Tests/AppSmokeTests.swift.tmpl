import Testing

@testable import {{pascal .Name}}

// App-level tests run via `mise run -C {{.Dir}} test:app` (Tuist / xcodebuild) — a
// Mac-only secondary surface. `specify verify` does NOT run these; the
// spec-provable scenarios live in the headless Core. AppKit-wiring scenarios that
// can only be proven here bind with the same `.scenario()` trait as the Core tests.
@MainActor
@Suite("app smoke")
struct AppSmokeTests {
    @Test("the main window controller builds a titled window")
    func windowBuilds() {
        let controller = MainWindowController()
        #expect(controller.window?.title == "{{pascal .Name}}")
    }
}
