import AppKit
import {{pascal .Name}}Core

/// The main window — a deliberately small AppKit surface that reads the headless
/// Core's @Observable model, proving the view layer links the Core and launches.
/// Grow it with the appkit-* skills (semantic colors, accessibility identifiers,
/// Auto Layout, Liquid Glass).
@MainActor
final class MainWindowController: NSWindowController {
    private let todos = TodoList(items: [
        Todo(label: "Knead the dough"),
        Todo(label: "Preheat the oven"),
    ])

    convenience init() {
        let window = NSWindow(
            contentRect: NSRect(x: 0, y: 0, width: 480, height: 240),
            styleMask: [.titled, .closable, .miniaturizable, .resizable],
            backing: .buffered,
            defer: false
        )
        window.title = "{{pascal .Name}}"
        window.center()
        self.init(window: window)

        let label = NSTextField(labelWithString: "\(todos.items.count) to-dos")
        label.font = .preferredFont(forTextStyle: .title1)
        label.translatesAutoresizingMaskIntoConstraints = false
        label.setAccessibilityIdentifier("todo-count")

        let content = NSView()
        content.addSubview(label)
        NSLayoutConstraint.activate([
            label.centerXAnchor.constraint(equalTo: content.centerXAnchor),
            label.centerYAnchor.constraint(equalTo: content.centerYAnchor),
        ])
        window.contentView = content
    }
}
