// swift-tools-version: 6.0
import PackageDescription

// {{.Name}}'s headless core. Dynamic module names ({{pascal .Name}}Core) with a
// static directory (Sources/Core) via explicit `path:` — the scaffold renderer
// substitutes file contents, not directory names, so the dirs stay fixed while
// the module is named after the app.
//
// This file is the composition seam: optional `--with` features add their deps and
// targets here behind `{{ "{{" }}if .Features.<name>}}` so two features never collide on it;
// each feature ships only its additive source files. Feature tests always land in
// the single CoreTests target — multiple test targets clobber the event-stream report.
let package = Package(
    name: "{{pascal .Name}}",
    platforms: [.macOS(.v14), .iOS(.v17)],
    products: [
        // The library product the Tuist app target consumes (`.package(product:)`).
        // `swift test` doesn't need it, but the app does.
        .library(name: "{{pascal .Name}}Core", targets: ["{{pascal .Name}}Core"]),
        {{- if .Features.swiftdata}}
        .library(name: "{{pascal .Name}}Persistence", targets: ["{{pascal .Name}}Persistence"]),
        {{- end}}
        {{- if .Features.openapi}}
        .library(name: "{{pascal .Name}}API", targets: ["{{pascal .Name}}API"]),
        {{- end}}
    ],
    {{- if .Features.openapi}}
    // SwiftPM requires `dependencies` after `products` and before `targets`.
    dependencies: [
        .package(url: "https://github.com/apple/swift-openapi-generator", from: "1.0.0"),
        .package(url: "https://github.com/apple/swift-openapi-runtime", from: "1.0.0"),
        .package(url: "https://github.com/apple/swift-openapi-urlsession", from: "1.0.0"),
    ],
    {{- end}}
    targets: [
        .target(name: "{{pascal .Name}}Core", path: "Sources/Core"),
        // Shared test support: the .spec/.scenario binding traits, defined once and
        // imported by every test target.
        .target(name: "TestSupport", path: "Tests/Support"),
        .testTarget(
            name: "{{pascal .Name}}CoreTests",
            // ONE test target holds the whole suite, so a single `swift test
            // --event-stream-output-path` report captures every test (multiple test
            // targets each truncate that file). Feature tests land here and pull in the
            // feature's source target.
            dependencies: [
                "{{pascal .Name}}Core", "TestSupport",
                {{- if .Features.swiftdata}}
                "{{pascal .Name}}Persistence",
                {{- end}}
                {{- if .Features.openapi}}
                "{{pascal .Name}}API",
                .product(name: "OpenAPIRuntime", package: "swift-openapi-runtime"),
                {{- end}}
            ],
            path: "Tests/CoreTests"
        ),
        {{- if .Features.swiftdata}}
        // The SwiftData cache shell. No strictMemorySafety: SwiftData's macros and
        // runtime sit outside this package's memory-safety proof. Tested headlessly
        // against a temp-file (reopened) and in-memory ModelContainer.
        .target(
            name: "{{pascal .Name}}Persistence",
            dependencies: ["{{pascal .Name}}Core"],
            path: "Sources/Persistence"
        ),
        {{- end}}
        {{- if .Features.openapi}}
        // Contract-first API client: the OpenAPIGenerator build-tool plugin generates
        // the Client/Types from Sources/API/openapi.yaml at build time (first build
        // resolves the swift-openapi-* packages — network). The hand-written facade
        // (TodoAPIClient) is the public surface; the generated code stays internal.
        .target(
            name: "{{pascal .Name}}API",
            dependencies: [
                .product(name: "OpenAPIRuntime", package: "swift-openapi-runtime"),
                .product(name: "OpenAPIURLSession", package: "swift-openapi-urlsession"),
            ],
            path: "Sources/API",
            plugins: [.plugin(name: "OpenAPIGenerator", package: "swift-openapi-generator")]
        ),
        {{- end}}
    ]
)
