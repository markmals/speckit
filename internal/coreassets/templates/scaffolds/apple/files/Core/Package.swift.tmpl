import PackageDescription

// {{.Name}}'s headless core. Dynamic module names ({{pascal .Name}}Core) with a
// static directory (Sources/Core) via explicit `path:` — the scaffold renderer
// substitutes file contents, not directory names, so the dirs stay fixed while
// the module is named after the app.
let package = Package(
    name: "{{pascal .Name}}",
    platforms: [.macOS(.v14), .iOS(.v17)],
    targets: [
        .target(name: "{{pascal .Name}}Core", path: "Sources/Core"),
        .testTarget(
            name: "{{pascal .Name}}CoreTests",
            dependencies: ["{{pascal .Name}}Core"],
            path: "Tests/CoreTests"
        ),
    ]
)
