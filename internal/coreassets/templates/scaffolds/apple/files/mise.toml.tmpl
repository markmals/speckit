# {{.Name}} — an Apple app. The spec-provable behaviour lives in a headless
# SwiftPM package (Core/) that builds and tests with `swift test` alone, so
# `specify verify` never needs Tuist, an Xcode project, a simulator, or signing.
# The AppKit app surface (macOS/) is Tuist-managed — Project.swift is the source
# of truth; the generated .xcodeproj/.xcworkspace/Derived are gitignored.
#
# Swift + swift-format come from the active Xcode toolchain (not pinned by mise);
# Tuist is pinned here. `mise run test` writes the Swift Testing event stream the
# engine's `swift` format joins.
[tools]
tuist = "4.196.1"

[vars]
package_path = "Core"

[tasks.test]
description = "run the test suite, writing the event-stream report the engine joins"
run = "swift test --package-path Core --event-stream-output-path test.swift-events.ndjson --event-stream-version 0"

[tasks.generate]
alias = "g"
description = "generate the Xcode project from Project.swift (Tuist)"
run = "tuist generate --no-open"

[tasks.build]
alias = "b"
description = "generate + build the macOS app (the reference surface)"
run = '''
tuist generate --no-open
tuist xcodebuild build -scheme {{pascal .Name}}
'''

[tasks."test:app"]
description = "run the app-level tests via xcodebuild (needs a generated project)"
run = "tuist test {{pascal .Name}}"

[tasks."launch:macos"]
description = "build and launch the macOS app"
run = '''
tuist generate --no-open
xcodebuild -workspace {{pascal .Name}}.xcworkspace -scheme {{pascal .Name}} -configuration Debug \
  -derivedDataPath Derived build
open Derived/Build/Products/Debug/{{pascal .Name}}.app
'''

[tasks.fmt]
description = "format Swift sources in place (swift-format). Pass paths to format just those."
run = '''
if [ "$#" -gt 0 ]; then
  for f in "$@"; do case "$f" in *.swift) swift format --in-place "$f" ;; esac; done
else
  for d in Core macOS iOS Sources Tests; do
    if [ -d "$d" ]; then swift format --in-place --recursive "$d"; fi
  done
fi
'''

[tasks.lint]
alias = "l"
description = "lint Swift sources (swift-format, strict)"
run = '''
dirs=""
for d in Core macOS iOS Sources Tests; do
  if [ -d "$d" ]; then dirs="$dirs $d"; fi
done
if [ -n "$dirs" ]; then swift format lint --strict --recursive $dirs; fi
'''
