import ProjectDescription

// The macOS app target (the reference surface). The pure, spec-provable core
// lives in the local `Core` SwiftPM package; this target adds the AppKit view
// layer. `specify verify` runs the Core headlessly — this project is for
// building and running the app. The generated .xcodeproj/.xcworkspace are
// gitignored; Project.swift is the source of truth (`mise run generate`).
let project = Project(
    name: "{{pascal .Name}}",
    packages: [.package(path: "Core")],
    settings: .settings(base: [
        "CODE_SIGNING_ALLOWED": "NO",
        "SWIFT_VERSION": "6.0",
        "MARKETING_VERSION": "0.1.0",
        "CURRENT_PROJECT_VERSION": "1",
    ]),
    targets: [
        .target(
            name: "{{pascal .Name}}",
            destinations: .macOS,
            product: .app,
            bundleId: "com.example.{{lower (pascal .Name)}}",
            deploymentTargets: .macOS("14.0"),
            infoPlist: .file(path: "macOS/Info.plist"),
            sources: ["macOS/Sources/**"],
            dependencies: [.package(product: "{{pascal .Name}}Core")]
        ),
        .target(
            name: "{{pascal .Name}}Tests",
            destinations: .macOS,
            product: .unitTests,
            bundleId: "com.example.{{lower (pascal .Name)}}.tests",
            deploymentTargets: .macOS("14.0"),
            sources: ["macOS/Tests/**"],
            dependencies: [.target(name: "{{pascal .Name}}")]
        ),
    ]
)
