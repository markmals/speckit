import Foundation
import SwiftData
import {{pascal .Name}}Core

/// A SwiftData-backed store for `Todo`s — the effectful cache shell that maps the
/// pure domain type to/from its on-disk record. Tested headlessly against a
/// temp-file (reopened) and an in-memory ModelContainer, so persistence is
/// spec-provable without an app, a simulator, or signing.
@MainActor
public final class SwiftDataTodoStore {
    private let container: ModelContainer

    /// Open (creating if needed) the on-disk store. Pass `nil` for an ephemeral
    /// in-memory store (tests, previews).
    public init(url: URL? = nil) throws {
        let config =
            url.map { ModelConfiguration(url: $0) }
            ?? ModelConfiguration(isStoredInMemoryOnly: true)
        container = try ModelContainer(for: TodoRecord.self, configurations: config)
    }

    public func save(_ todo: Todo) throws {
        let context = container.mainContext
        context.insert(TodoRecord(id: todo.id, label: todo.label, isDone: todo.isDone))
        try context.save()
    }

    public func all() throws -> [Todo] {
        let records = try container.mainContext.fetch(FetchDescriptor<TodoRecord>())
        return records.map { Todo(id: $0.id, label: $0.label, isDone: $0.isDone) }
    }
}
