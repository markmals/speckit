{
  "stack": "apple",
  "memberDir": "apps",
  "scripts": [
    {
      "phase": 0,
      "commands": [
        "mise trust"
      ]
    },
    {
      "phase": 1,
      "silent": true,
      "commands": [
        "for d in Core macOS iOS; do if [ -d \"$d\" ]; then swift format --in-place --recursive \"$d\"; fi; done"
      ]
    }
  ],
  "features": {
    "swiftdata": {
      "files": "features/swiftdata/files"
    },
    "openapi": {
      "files": "features/openapi/files"
    }
  },
  "target": {
    "command": "cd {{.Dir}} && mise run test",
    "format": "swift",
    "report": "{{.Dir}}/Core/test.swift-events.ndjson",
    "source": "{{.Dir}}/Core",
    "bindings": "scoped"
  }
}
