// swift-tools-version: 6.0
import PackageDescription

// {{.Name}} — a Swift command-line tool. The provable logic lives in a library target
// ({{pascal .Name}}Core, over the static Sources/Core directory via an explicit `path:`)
// that builds and tests with `swift test` alone — exactly what `specify verify` runs.
// The executable target ({{kebab .Name}}) is a thin swift-argument-parser shell over
// that library, so the behaviour is proven headlessly without running the binary. The
// renderer substitutes file contents, not directory names, so the dirs stay fixed.
let package = Package(
    name: "{{pascal .Name}}",
    platforms: [.macOS(.v13)],
    products: [
        .executable(name: "{{kebab .Name}}", targets: ["{{kebab .Name}}"]),
        .library(name: "{{pascal .Name}}Core", targets: ["{{pascal .Name}}Core"]),
    ],
    dependencies: [
        .package(url: "https://github.com/apple/swift-argument-parser", from: "1.5.0")
    ],
    targets: [
        // The testable logic — pure, no I/O, no argument parsing.
        .target(name: "{{pascal .Name}}Core", path: "Sources/Core"),
        // The thin CLI shell: parses arguments and delegates to the Core.
        .executableTarget(
            name: "{{kebab .Name}}",
            dependencies: [
                "{{pascal .Name}}Core",
                .product(name: "ArgumentParser", package: "swift-argument-parser"),
            ],
            path: "Sources/CLI"
        ),
        // Shared test support: the .spec/.scenario binding traits.
        .target(name: "TestSupport", path: "Tests/Support"),
        .testTarget(
            name: "{{pascal .Name}}CoreTests",
            dependencies: ["{{pascal .Name}}Core", "TestSupport"],
            path: "Tests/CoreTests"
        ),
    ]
)
