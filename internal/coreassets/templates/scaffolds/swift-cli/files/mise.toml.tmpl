# {{.Name}} — a Swift command-line tool. The spec-provable logic lives in a library
# ({{pascal .Name}}Core) that builds and tests with `swift test` alone, so `specify
# verify` needs no Xcode project, simulator, or signing; the executable is a thin shell
# over it. Swift + swift-format come from the active toolchain (not pinned here).
# `mise run test` writes the Swift Testing event stream the engine's `swift` format
# joins.

# The local dependency gate (`mise run deps`) runs Renovate (a node tool) + jq;
# pin them here since the stack otherwise leans on the ambient Swift toolchain.
[tools]
node = "24"
"npm:renovate" = "latest"
jq = "latest"

[tasks.test]
description = "run the test suite, writing the event-stream report the engine joins"
run = "swift test --event-stream-output-path test.swift-events.ndjson --event-stream-version 0"

[tasks.build]
alias = "b"
description = "build the package (library + executable)"
run = "swift build"

[tasks.run]
alias = "r"
description = "run the CLI (pass args after --, e.g. mise run run -- Ada --shout)"
run = "swift run {{kebab .Name}}"

[tasks.fmt]
description = "format Swift sources in place (swift-format). Pass paths to format just those."
run = '''
if [ "$#" -gt 0 ]; then
  for f in "$@"; do case "$f" in *.swift) swift format --in-place "$f" ;; esac; done
else
  for d in Sources Tests; do
    if [ -d "$d" ]; then swift format --in-place --recursive "$d"; fi
  done
fi
'''

[tasks.lint]
alias = "l"
description = "lint Swift sources (swift-format, strict)"
run = '''
dirs=""
for d in Sources Tests; do
  if [ -d "$d" ]; then dirs="$dirs $d"; fi
done
if [ -n "$dirs" ]; then swift format lint --strict --recursive $dirs; fi
'''

# Local dependency check — advisory (never opens PRs, always exits 0). Replaces
# Dependabot: surfaces available updates as part of `mise run check`.
[tasks.deps]
description = "report available dependency updates (local Renovate dry-run; no PRs)"
run = "bash scripts/deps-check.sh"

[tasks.check]
description = "all local quality gates: lint + the dependency heads-up"
depends = ["lint", "deps"]
run = ":"
